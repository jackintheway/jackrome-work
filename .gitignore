# macOS
.DS_Store

# Per-machine Claude Code permissions, not shared config.
.claude/settings.local.json

# Verification harnesses are written and deleted inside a session.
_verify-harness.html
_peek.html
_measure.html
_*.tmp

# Source material, kept on The Key and never shipped.
#
# Squarespace exports come out as full-resolution originals and the
# audio masters are lossless. Both are the things to keep, and both
# are far too large for a repo that Netlify redeploys on every push.
# What ships is the web-sized derivative in assets/, committed.
_source/

# Exhibit packages, the raw output of the /exhibit skill.
#
# These are scrubbed and scan-gated, but this repo is public, so a
# package sits here unpublished until Jack has read it himself. What
# ships is the page built from it, committed like any other page.
# Canonical copies go to Claude Creations/exhibitions/ in iCloud.
_exhibits/

# The assembled publish folder. tools/build-site.py rebuilds it from the
# allowlist on every Netlify deploy, so it is output, not source.
_site/
_livecheck.tmp.*/

# Installed packages for the assessment function. Netlify installs
# from package-lock.json at build time.
node_modules/

# Private working output: model pilot reports, record exports, anything
# that came out of a real account or a real submission. Never committed.
_private/
